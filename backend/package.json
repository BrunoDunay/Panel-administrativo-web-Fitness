{
  "name": "fbe-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de Fitness by Evidence (Germain Camarillo)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file=.env src/config/migrate.js up",
    "migrate:down": "node --env-file=.env src/config/migrate.js down",
    "test": "vitest run",
    "seed:demo": "node --env-file=.env seeders/demo-clients.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^6.0.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
